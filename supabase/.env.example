# These are set via `supabase secrets set --env-file supabase/.env` (copy this
# file to supabase/.env first and fill in real values — never commit that file).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# Edge Runtime and must NOT be set here.

# ---- Internal auth ----
# orders-api itself needs no secret here — it's gated by real Supabase Auth
# (email + password), see config.toml's verify_jwt and README's "Criando
# usuarios do painel" section. Only the cron needs a shared secret.
# Shared secret pg_cron sends as the x-cron-secret header when it calls reconciliation-cron.
CRON_SECRET=change-me-to-another-long-random-string

# ---- Shopify ----
# Comma-separated list of store keys. Each key gets its own credential block
# below (SHOPIFY_<KEY>_...). Add a new key here + its four vars to onboard
# another store later — no code changes needed.
SHOPIFY_STORE_KEYS=basico,exclusivos

# Human label shown in the panel (optional, falls back to the key itself)
SHOPIFY_BASICO_LABEL="Drop Básico"
# Store domain without protocol, e.g. minha-loja.myshopify.com
SHOPIFY_BASICO_SHOP_DOMAIN=m3ntalmadness.myshopify.com
# Client ID/Secret from this store's custom app (dev.shopify.com, "Custom app"
# with "Usar fluxo de instalacao legado" enabled) — used to fetch a fresh
# short-lived access token via OAuth client_credentials on every Admin API
# call. Shopify's newer custom-app credentials don't issue a permanent token.
SHOPIFY_BASICO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_BASICO_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Same value as CLIENT_SECRET above — Shopify uses the app's client/API
# secret to sign the orders/paid webhook HMAC too.
SHOPIFY_BASICO_WEBHOOK_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

SHOPIFY_EXCLUSIVOS_LABEL="Exclusivos"
SHOPIFY_EXCLUSIVOS_SHOP_DOMAIN=mental-madness-basic.myshopify.com
SHOPIFY_EXCLUSIVOS_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_EXCLUSIVOS_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_EXCLUSIVOS_WEBHOOK_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default Admin API version for any store that doesn't set its own
# SHOPIFY_<KEY>_API_VERSION override
SHOPIFY_API_VERSION=2024-07

# ---- Melhor Envio ----
# https://melhorenvio.com.br/api/v2 in production, https://sandbox.melhorenvio.com.br/api/v2 in sandbox
MELHORENVIO_BASE_URL=https://sandbox.melhorenvio.com.br/api/v2
# Long-lived OAuth2 bearer token generated manually in the Melhor Envio panel
MELHORENVIO_ACCESS_TOKEN=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only needed if/when you wire up automatic token refresh
MELHORENVIO_REFRESH_TOKEN=
MELHORENVIO_CLIENT_ID=
MELHORENVIO_CLIENT_SECRET=
# Sent as User-Agent header, required by Melhor Envio to identify the application
MELHORENVIO_USER_AGENT="MM Etiquetas (contato@suaempresa.com.br)"
# Melhor Envio "from" (origin) address used on every cart request
MELHORENVIO_FROM_NAME="Minha Empresa"
MELHORENVIO_FROM_PHONE=11999999999
MELHORENVIO_FROM_EMAIL=contato@suaempresa.com.br
MELHORENVIO_FROM_DOCUMENT=00000000000
MELHORENVIO_FROM_POSTAL_CODE=01310930
MELHORENVIO_FROM_ADDRESS="Av. Paulista"
MELHORENVIO_FROM_NUMBER=1000
MELHORENVIO_FROM_COMPLEMENT=
MELHORENVIO_FROM_DISTRICT="Bela Vista"
MELHORENVIO_FROM_CITY="Sao Paulo"
MELHORENVIO_FROM_STATE_ABBR=SP
# Fixed carrier/service used as fallback: when MELHORENVIO_AUTO_CHEAPEST=false,
# when the shipping-quote call fails, or when no quote comes back valid for
# the destination. Find service ids at GET /api/v2/me/shipment/services.
MELHORENVIO_SERVICE_ID=1
# When true (default), every order automatically picks the cheapest available
# shipping quote via POST /me/shipment/calculate instead of always using
# MELHORENVIO_SERVICE_ID.
MELHORENVIO_AUTO_CHEAPEST=true
# Optional comma-separated allow-list of service ids to consider when picking
# the cheapest quote (e.g. "1,2,4" to only compare Correios PAC/SEDEX + Jadlog
# .Package). Leave empty to consider every service Melhor Envio quotes back.
MELHORENVIO_ALLOWED_SERVICE_IDS=
MELHORENVIO_PLATFORM_NAME="MM Etiquetas"
# Fixed volume/weight estimate by item count (the store doesn't track real
# per-product weight in Shopify) — matches Vitor's manual process exactly.
VOLUME_SINGLE_HEIGHT_CM=2
VOLUME_SINGLE_WIDTH_CM=20
VOLUME_SINGLE_LENGTH_CM=20
VOLUME_SINGLE_WEIGHT_KG=0.5
VOLUME_MULTI_HEIGHT_CM=2
VOLUME_MULTI_WIDTH_CM=40
VOLUME_MULTI_LENGTH_CM=40
VOLUME_MULTI_WEIGHT_KG=1

# ---- Alerts ----
# Generic incoming webhook (Slack-compatible: expects {"text": "..."} JSON body)
ALERT_WEBHOOK_URL=
# Hours a shipment can stay stuck in a non-terminal status before an alert fires
ALERT_STUCK_HOURS=4
